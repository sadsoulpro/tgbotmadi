# Add this as a NEW virtual host. Do not replace the existing website's config.
server {
    listen 80;
    server_name tgbot.madirahman.com;

    client_max_body_size 60m;

    location / {
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}

# After HTTP routing works, obtain a TLS certificate using the server's
# existing certificate setup. If Certbot is already installed with Nginx:
# sudo certbot --nginx -d tgbot.madirahman.com
